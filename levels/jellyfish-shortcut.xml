		<Level bgColor="0xF4A800" levelSize="400">
			<SpawnBillboard name="tobecontinued" posX="0" posY="0" />
			<SpawnFood num="8" foodType="1" hpMin="15" hpVar="10" />
		</Level>
		<Level bgColor="0xE7A700" levelSize="400">
			<SpawnBillboard name="warning" posX="0" posY="0" />
			<SpawnFood num="8" foodType="1" hpMin="15" hpVar="10" />
			<SpawnFish num="2" numSegs="3" maxSegs="16" randEvolve="0" segLength="15"
				   speedMin="30" speedVar="5" turnMin="8" turnVar="3" panic="true" />
		</Level>
		<Level bgColor="0xD8A500" levelSize="400">
			<SpawnFood num="10" foodType="2" hpMin="15" hpVar="10" />			
		</Level>
		<Level bgColor="0xC99F00" levelSize="400">
