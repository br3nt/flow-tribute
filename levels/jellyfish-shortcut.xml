<flOw>
	<!-- Shortcut to the Jellyfish campaign. Campaign 1 is cut to its title screen and its final boss (12 segments
	     instead of 40). Eat the boss, then eat the gold egg it drops: you turn into an egg, float to the top and hatch
	     as a jellyfish in campaign 2. Campaign 2 is unchanged from Jenova Chen's levels.xml. -->
	<Campaign num="1" player="Snakefish">
		<!-- Title screen -->
		<Level bgColor="0x00BFFF" levelSize="300">
			<SpawnBillboard name="flowing_title" posX="0" posY="0" />
		</Level>
		<!-- Final boss, smaller -->
		<Level bgColor="0x03110E" levelSize="400">
			<SpawnFood num="10" foodType="5" hpMin="15" hpVar="10" />
			<SpawnFish num="1" numSegs="12" maxSegs="12" randEvolve="4" segLength="15"
				   speedMin="0" speedVar="5" turnMin="6" turnVar="1" panic="false" />
		</Level>
	</Campaign>

	<Campaign num="2" player="Jellyfish">
		<!------ Title screen ------>
		<Level bgColor="0xFFA900" levelSize="300">
			<SpawnBillboard name="flowing_title" posX="0" posY="0" />
		</Level>
